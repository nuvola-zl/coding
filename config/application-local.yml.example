# ============================================================================
#  本机真实配置的模板（这个文件可以提交，里面全是假的占位值）
#
#  用法：
#     cp config/application-local.yml.example config/application-local.yml
#   然后把下面的占位值换成你自己的。application-local.yml 已被 .gitignore 忽略。
#
#  每条都写成 ${环境变量名:兜底值}：
#    - 本机开发：不设环境变量，用冒号后面的值
#    - 部署到服务器：不传这个文件，只注入环境变量即可
#
#  环境变量不够用的时候也可以在这里加配置，比如：
#    spring:
#      datasource:
#        password: ${DB_PASSWORD:改成你的数据库密码}
# ============================================================================

app:
  storage:
    aliyun:
      # OSS 控制台 → Bucket → 概览 →「地域节点」（不要带 https:// 前缀）
      endpoint: ${OSS_ENDPOINT:oss-cn-hangzhou.aliyuncs.com}

      # RAM 子账号的 AccessKey。不要用主账号 AK，权限也只给这一个 Bucket
      # 填了这四项，程序就会自动从「本地磁盘」切到「阿里云 OSS」，代码不用改
      access-key-id: ${OSS_ACCESS_KEY_ID:你的AccessKeyId}
      access-key-secret: ${OSS_ACCESS_KEY_SECRET:你的AccessKeySecret}

      # Bucket 名称，只写名字（不是 xxx.oss-cn-hangzhou.aliyuncs.com）
      bucket: ${OSS_BUCKET:你的Bucket名}
